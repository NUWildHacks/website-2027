    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-svelte": "^0.11.1",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
